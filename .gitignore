# Secrets (SEC 2) - this file must exist before any API key does
.env
.env.local
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Node / frontend
node_modules/
dist/

# Raw dataset snapshots - large, licensed, never committed
data/raw/

# Build artifacts from the ML pipeline
data/artifacts/

# Databases: ignored by default, with one exception for the shared published copy
*.db
*.sqlite
*.sqlite3
# On main, data/games.db is un-ignored so the 1,000-game build is shared by
# `git pull`. That exception is removed on this branch: the full 89,618-game
# build is about 330 MB, over GitHub's 100 MB file limit. Build it locally.
!data/map.db

# OS
.DS_Store
Thumbs.db

